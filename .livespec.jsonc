{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  "template": "livespec-with-diagrams",
  "spec_root": "SPECIFICATION",
  // Conformance profile(s) this governed repo satisfies — the LOCAL
  // declaration (mirroring the central fleet manifest), per
  // livespec/SPECIFICATION/non-functional-requirements.md §"Conformance
  // Pattern". `baseline` is the universal worktree-discipline floor: the
  // structural commit-refuse hook (installed via `just
  // install-commit-refuse-hooks`, REUSED from livespec-dev-tooling) plus its
  // verifier `just check-baseline`, wired into the `just check` aggregate.
  "profile": ["baseline"],
  // Declared agent-runtime harnesses for the Conformance Pattern's cross-harness
  // plugin-resolution concern (concern #2), read by livespec-dev-tooling's
  // check-plugin-resolution Verifier. This is the Rust Control-Plane console; it
  // ships no command/skill surface to resolve from a harness, so both are EXEMPT.
  "harnesses": {
    "claude": { "status": "exempt", "reason": "livespec-console-beads-fabro is the Rust Control-Plane console; it ships no command/skill surface to resolve from a harness" },
    "codex":  { "status": "exempt", "reason": "livespec-console-beads-fabro is the Rust Control-Plane console; it ships no command/skill surface to resolve from a harness" }
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by typed cross-tenant `depends_on` refs so the Dispatcher
  // readiness gate can fail closed on still-open sibling work.
  "cross_repo_targets": {
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    },
    "livespec-orchestrator-beads-fabro": {
      "github_url": "https://github.com/thewoolleyman/livespec-orchestrator-beads-fabro",
      "local_clone": "/data/projects/livespec-orchestrator-beads-fabro",
      "default_branch": "master"
    },
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    },
    "livespec-overseer": {
      "github_url": "https://github.com/thewoolleyman/livespec-overseer",
      "local_clone": "/data/projects/livespec-overseer",
      "default_branch": "master"
    }
  },
  // Cross-repo section citations this spec tree is allowed to make. The
  // no-cross-spec-reference doctor check refuses a section citation that does
  // not resolve inside THIS SPECIFICATION/ tree unless it is listed here, which
  // is what keeps a citation of a sibling's section from rotting silently.
  // Added 2026-08-21 with the per-item factory-dispatch launcher argv contract,
  // which binds the orchestrator's GOVERNED loop surface and must cite the
  // sections that govern it.
  "external_references": {
    "livespec-orchestrator-beads-fabro": [
      "SPECIFICATION/contracts.md §\"Dispatcher loop invocation surface\"",
      "SPECIFICATION/contracts.md §\"Fail-closed cost gate (keyed on `--item` presence)\"",
      "SPECIFICATION/contracts.md §\"The skill surface\""
    ]
  },
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // livespec-overseer foreman config. foreman_valve_disposition governs how the
  // per-repo foreman handles blocked sessions and human valves it observes:
  //   "report-only" (default) — surface to the maintainer, take no action.
  //   "consensus"              — may convene the cross-vendor foreman-consensus
  //     panel (2 Anthropic + 1 non-Anthropic reviewer, dissent-forcing on the
  //     non-Anthropic seat) and act on its typed verdict via foreman-act.
  //     Decisions that are human-gated by design, or where the panel disagrees
  //     or evidence is insufficient, still escalate regardless of this setting.
  //   2026-08-16 — set to "consensus", maintainer-directed.
  "livespec-overseer": {
    "foreman_valve_disposition": "consensus"
  },
  // ACTIVE spec_governance overrides. Only the entries this repo intentionally
  // overrides appear here; every other key keeps the safe default documented in
  // the commented reference block below.
  //   2026-08-14 — propose_change_mode set to "batch", maintainer-directed
  //     fleet-wide autonomy lever rollout: /livespec:propose-change files
  //     without an interactive dialogue.
  //   2026-08-16 — critique_mode, in_flight_alignment, revise_decision_mode,
  //     ratification_review, spec_pr_merge armed to their safe fully-autonomous
  //     values (epic livespec-jvdvx4 fleet-wide rollout, child livespec-jvdvx4.15).
  //     ratification_reviewer_model is set to "fable" (the fleet convention,
  //     matching livespec core) because ratification_review: "auto-spawn" is
  //     inert without a configured reviewer model (effective_ratification_review
  //     falls back to requiring human input when it is unset).
  //     doctor_dispositions and dispatcher.merge_on_review_cap are deliberately
  //     out of scope for this pass (see the child item for why).
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "ratification_reviewer_model": "fable",
    "revise_decision_mode": "delegated",
    "ratification_review": "auto-spawn",
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest; leaving this block commented arms nothing, so
  // every operation uses the same safe defaults it would use with no
  // spec_governance block at all.
  // To enable any key, add the block as a real key above and keep only the
  // entries this repo intentionally overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green")
  //     "spec_pr_merge": "manual"
  //   }
  //
  // Credential-injection wrapper (fleet default) prefixed to the beads CLIs so a bare invocation self-heals its tenant secret.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": {
      "livespec": ">=0.1.0,<1.0.0",
      // Pinned to the latest livespec-core RELEASE tag, not the moving
      // `master` ref: a release is reproducible and carries release-gate
      // validation, per the fleet "pins track the latest RELEASE, not raw
      // master" discipline. Advanced off the `master` bootstrap placeholder
      // (which left CI hostage to core master's transient content); the
      // bump-pin fan-out rewrites this to each new release tag going forward.
      "pinned": "v0.37.0"
    },
    "connection": {
      "tenant": "livespec-console-beads-fabro",
      "prefix": "livespec-console-beads-fabro",
      "database": "livespec-console-beads-fabro",
      "server_user": "livespec-console-beads-fabro",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Human-valve settings. HISTORY, because this block has been changed twice
    // and the reasons matter:
    //   2026-07-20 — autonomous-mode levers set (auto_approve_ready: true,
    //     acceptance_mode: "ai-only") for the autonomous-mode acceptance work.
    //   2026-07-21 — both restored to safe defaults (plan/archive/console-happy-path-mvp/)
    //     because that mode was retired and the happy-path walk admits at the
    //     approve valve and ships at the accept valve.
    //   2026-07-29 — acceptance_mode set BACK to "ai-only", maintainer-directed:
    //     every fleet member is "ai-only". This DELIBERATELY overrides the
    //     2026-07-21 reasoning above for the acceptance half. That reasoning is
    //     preserved rather than deleted so the next reader sees a decision was
    //     reversed, not that it never existed.
    //   2026-08-14 — auto_approve_ready set BACK to true, maintainer-directed:
    //     this repo was the last core-fleet holdout with the lever off, and the
    //     maintainer confirmed the flip after being told every other core-fleet
    //     repo already has it true. This DELIBERATELY overrides the 2026-07-21
    //     reasoning above for the admission half; both halves are now autonomous.
    // Current — both halves autonomous:
    //   auto_approve_ready: true    — ready items dispatch without a human ADMIT.
    //   acceptance_mode: "ai-only"  — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, stays at its safe `false`
    // default: a review that cannot converge within `review_fix_cap` rounds is
    // precisely the case that must reach a human. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      "auto_approve_ready": true,
      "acceptance_mode": "ai-only",
      "wip_cap": 10,
      "factories": {
        "hp": { "server": "https://hp-xubuntu.perch-rudd.ts.net:32276" },
        "vps": { "server": "https://vps.perch-rudd.ts.net:32276" }
      },
      "default_factory": "hp"
    }
  }
}
